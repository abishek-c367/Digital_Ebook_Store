# Razorpay (server-side only — used by edge functions, set these as
# Supabase Edge Function secrets, never in the client .env)
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# From Razorpay Dashboard → Settings → Webhooks, after you create the webhook
# (see README "Setting up Razorpay" for the exact URL and events to use)
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret

# Used to build links inside purchase-confirmation emails
SITE_URL=https://your-deployed-site.example.com

# Email service (server-side only — used by edge functions, optional)
# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Admin setup:
# 1. Create an account through the signup page
# 2. In the Supabase dashboard, go to SQL Editor and run:
#    UPDATE profiles SET role = 'admin' WHERE email = 'your-email@example.com';
# 3. Log out and log back in to refresh your session
# 4. From then on, use Admin → Users in the app itself to add or remove
#    other accounts and grant/revoke admin access.
