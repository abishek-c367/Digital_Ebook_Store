# Supabase (pre-populated automatically — do not change)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe (server-side only — used by edge functions)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Email service (server-side only — used by edge functions)
# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Admin setup:
# 1. Create an account through the signup page
# 2. In the Supabase dashboard, go to SQL Editor and run:
#    UPDATE profiles SET role = 'admin' WHERE email = 'your-email@example.com';
# 3. Log out and log back in to refresh your session
